<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <!--
    Без этого блока WinForms не реагирует на WM_DPICHANGED при переносе окна
    между мониторами с разным масштабом, даже если в манифесте указан
    PerMonitorV2. Манифест включает OS-level awareness, эта секция —
    WinForms-level автоматический rescale форм и контролов.
  -->
  <System.Windows.Forms.ApplicationConfigurationSection>
    <add key="DpiAwareness" value="PerMonitorV2" />
    <add key="EnableWindowsFormsHighDpiAutoResizing" value="true" />
  </System.Windows.Forms.ApplicationConfigurationSection>
</configuration>
